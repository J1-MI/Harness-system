{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/VerificationSpec"
        }
      },
      "required": [
        "id",
        "description",
        "mandatory",
        "verification"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "BudgetRequest": {
      "additionalProperties": false,
      "properties": {
        "max_rework_iterations": {
          "minimum": 0,
          "title": "Max Rework Iterations",
          "type": "integer"
        },
        "max_turns": {
          "exclusiveMinimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "required": [
        "timeout_seconds",
        "max_turns",
        "max_rework_iterations"
      ],
      "title": "BudgetRequest",
      "type": "object"
    },
    "ConstraintSet": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "typed_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Typed Constraints",
          "type": "array"
        }
      },
      "title": "ConstraintSet",
      "type": "object"
    },
    "IntegrityRef": {
      "additionalProperties": false,
      "properties": {
        "canonical_digest": {
          "title": "Canonical Digest",
          "type": "string"
        },
        "supersedes_contract_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Contract Id"
        }
      },
      "required": [
        "canonical_digest"
      ],
      "title": "IntegrityRef",
      "type": "object"
    },
    "RepositoryRef": {
      "additionalProperties": false,
      "properties": {
        "base_commit_sha": {
          "title": "Base Commit Sha",
          "type": "string"
        },
        "expected_repository_fingerprint": {
          "title": "Expected Repository Fingerprint",
          "type": "string"
        },
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "target_ref": {
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "base_commit_sha",
        "target_ref",
        "expected_repository_fingerprint"
      ],
      "title": "RepositoryRef",
      "type": "object"
    },
    "RequestedCapabilities": {
      "additionalProperties": false,
      "description": "What a contract *asks for*. Never the source of effective permission.\n\nSee ``PolicyGrants`` for the trusted, policy-engine-computed counterpart.",
      "properties": {
        "command_ids": {
          "items": {
            "type": "string"
          },
          "title": "Command Ids",
          "type": "array"
        },
        "database_targets": {
          "items": {
            "type": "string"
          },
          "title": "Database Targets",
          "type": "array"
        },
        "external_systems": {
          "items": {
            "type": "string"
          },
          "title": "External Systems",
          "type": "array"
        },
        "mcp_tools": {
          "items": {
            "type": "string"
          },
          "title": "Mcp Tools",
          "type": "array"
        },
        "network_domains": {
          "items": {
            "type": "string"
          },
          "title": "Network Domains",
          "type": "array"
        },
        "package_install": {
          "default": false,
          "title": "Package Install",
          "type": "boolean"
        },
        "raw_shell": {
          "default": false,
          "title": "Raw Shell",
          "type": "boolean"
        },
        "workspace_access": {
          "$ref": "#/$defs/WorkspaceAccessLevel",
          "default": "READ_WRITE"
        }
      },
      "title": "RequestedCapabilities",
      "type": "object"
    },
    "ScopeRules": {
      "additionalProperties": false,
      "properties": {
        "allow_new_files": {
          "default": true,
          "title": "Allow New Files",
          "type": "boolean"
        },
        "allowed_path_rules": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Path Rules",
          "type": "array"
        },
        "declared_generated_paths": {
          "items": {
            "type": "string"
          },
          "title": "Declared Generated Paths",
          "type": "array"
        },
        "forbidden_path_rules": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Path Rules",
          "type": "array"
        },
        "max_changed_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Changed Bytes"
        },
        "max_changed_files": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Changed Files"
        }
      },
      "title": "ScopeRules",
      "type": "object"
    },
    "VerificationMethod": {
      "enum": [
        "COMMAND",
        "ASSERTION",
        "MANUAL"
      ],
      "title": "VerificationMethod",
      "type": "string"
    },
    "VerificationSpec": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assertion"
        },
        "command_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "expected_exit_codes": {
          "items": {
            "type": "integer"
          },
          "title": "Expected Exit Codes",
          "type": "array"
        },
        "expected_output_match": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Output Match"
        },
        "manual_instruction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Instruction"
        },
        "method": {
          "$ref": "#/$defs/VerificationMethod"
        },
        "required_evidence_kinds": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence Kinds",
          "type": "array"
        }
      },
      "required": [
        "method"
      ],
      "title": "VerificationSpec",
      "type": "object"
    },
    "WorkspaceAccessLevel": {
      "enum": [
        "NONE",
        "READ",
        "READ_WRITE"
      ],
      "title": "WorkspaceAccessLevel",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Codex-proposed / Harness-accepted task contract.\n\nDeliberately has no ``approval_required`` field and no effective\ncapability field: ``requested_capabilities`` is a request only, never a\ngrant. Effective permission lives exclusively in ``PolicyDecision.grants``.",
  "properties": {
    "acceptance_criteria": {
      "items": {
        "$ref": "#/$defs/AcceptanceCriterion"
      },
      "minItems": 1,
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "budget_request": {
      "$ref": "#/$defs/BudgetRequest"
    },
    "constraints": {
      "$ref": "#/$defs/ConstraintSet"
    },
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "contract_revision": {
      "minimum": 1,
      "title": "Contract Revision",
      "type": "integer"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityRef"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryRef"
    },
    "request_snapshot_ref": {
      "title": "Request Snapshot Ref",
      "type": "string"
    },
    "requested_capabilities": {
      "$ref": "#/$defs/RequestedCapabilities"
    },
    "required_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Required Evidence",
      "type": "array"
    },
    "risk_hints": {
      "items": {
        "type": "string"
      },
      "title": "Risk Hints",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ScopeRules"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "worker_profile_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Profile Ref"
    }
  },
  "required": [
    "contract_revision",
    "run_id",
    "task_id",
    "request_snapshot_ref",
    "objective",
    "repository",
    "scope",
    "constraints",
    "acceptance_criteria",
    "requested_capabilities",
    "budget_request",
    "integrity"
  ],
  "title": "TaskContract",
  "type": "object"
}
