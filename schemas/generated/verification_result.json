{
  "$defs": {
    "CriterionResult": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_VERIFIED",
        "NOT_APPLICABLE",
        "WAIVED"
      ],
      "title": "CriterionResult",
      "type": "string"
    },
    "CriterionVerification": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "result": {
          "$ref": "#/$defs/CriterionResult"
        },
        "waiver_approval_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Waiver Approval Ref"
        }
      },
      "required": [
        "id",
        "result"
      ],
      "title": "CriterionVerification",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Criterion Id"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        }
      },
      "required": [
        "id",
        "severity",
        "description"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "BLOCKER",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "VerificationDecision": {
      "enum": [
        "PASS",
        "REWORK",
        "REJECT",
        "MANUAL_REVIEW"
      ],
      "title": "VerificationDecision",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_digest": {
      "title": "Contract Digest",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/CriterionVerification"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/VerificationDecision"
    },
    "evidence_set_digest": {
      "title": "Evidence Set Digest",
      "type": "string"
    },
    "invocation_id": {
      "title": "Invocation Id",
      "type": "string"
    },
    "prohibited_changes": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Changes",
      "type": "array"
    },
    "quality_findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Quality Findings",
      "type": "array"
    },
    "remaining_risks": {
      "items": {
        "type": "string"
      },
      "title": "Remaining Risks",
      "type": "array"
    },
    "required_fixes": {
      "items": {
        "type": "string"
      },
      "title": "Required Fixes",
      "type": "array"
    },
    "result_snapshot_digest": {
      "title": "Result Snapshot Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_violations": {
      "items": {
        "type": "string"
      },
      "title": "Scope Violations",
      "type": "array"
    },
    "security_findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Security Findings",
      "type": "array"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "verification_id": {
      "title": "Verification Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "contract_digest",
    "result_snapshot_digest",
    "evidence_set_digest",
    "invocation_id",
    "decision",
    "criteria"
  ],
  "title": "VerificationResult",
  "type": "object"
}
